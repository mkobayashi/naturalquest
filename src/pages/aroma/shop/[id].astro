---
import Layout from '../../../layouts/Layout.astro';
import shopData from '../../../data/aroma_shop_data.json';

type Product = {
	brand: string;
	quality?: string;
	name: string;
	volume: string;
	amazon_url?: string;
	rakuten_url?: string;
};

type OilShop = { name: string; products: Product[] };

const shop = shopData as Record<string, OilShop>;

export function getStaticPaths() {
	return Object.keys(shopData as Record<string, unknown>).map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
const oil = id ? shop[id] : undefined;
if (!oil) return Astro.redirect('/aroma/shop/');
---

<Layout
	title={`${oil.name}精油を選ぶ | Natural Quest`}
	description={`品質重視のブランドから${oil.name}精油をご紹介します。`}
	narrow={false}
>
	<div class="shop-page">
		<h1>{oil.name}精油を選ぶ</h1>
		<p class="shop-lead">品質重視のブランドから {oil.name} 精油をご紹介します。</p>

		<section class="oil-section">
			<div class="product-grid">
				{
					oil.products.map((p) => (
						<div class="product-card">
							<div class="product-header">
								<span class="brand">{p.brand}</span>
								{p.quality ? <span class="quality">{p.quality}</span> : null}
							</div>
							<p class="product-name">{p.name}</p>
							<p class="product-vol">{p.volume}</p>
							<div class="product-links">
								{p.amazon_url ? (
									<a
										href={p.amazon_url}
										target="_blank"
										rel="noopener noreferrer sponsored"
										class="btn-amazon"
									>
										Amazon
									</a>
								) : null}
								{p.rakuten_url ? (
									<a
										href={p.rakuten_url}
										target="_blank"
										rel="noopener noreferrer sponsored"
										class="btn-rakuten"
									>
										楽天
									</a>
								) : null}
							</div>
						</div>
					))
				}
			</div>
		</section>

		<nav class="shop-footer-nav" aria-label="関連ページ">
			<a href="/aroma/">アロマAIチャットに戻る</a>
		</nav>
	</div>
</Layout>

<style>
	.shop-page {
		max-width: 860px;
		margin: 0 auto;
		padding: 2rem 1rem;
	}
	.shop-page h1 {
		font-size: 1.6rem;
		font-weight: 500;
		margin-bottom: 0.5rem;
	}
	.shop-lead {
		font-size: 0.9rem;
		color: #666;
		margin-bottom: 2rem;
	}
	.oil-section {
		margin-bottom: 2rem;
	}
	.product-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
		gap: 12px;
	}
	.product-card {
		background: white;
		border: 0.5px solid #e8e4da;
		border-radius: 10px;
		padding: 12px;
	}
	.product-header {
		display: flex;
		align-items: center;
		gap: 6px;
		margin-bottom: 6px;
	}
	.brand {
		font-size: 10px;
		font-weight: 500;
		color: #2d6a4f;
		letter-spacing: 0.05em;
	}
	.quality {
		font-size: 10px;
		padding: 1px 6px;
		background: #eaf3de;
		color: #3b6d11;
		border-radius: 10px;
	}
	.product-name {
		font-size: 12px;
		font-weight: 500;
		color: #333;
		margin-bottom: 4px;
		line-height: 1.4;
	}
	.product-vol {
		font-size: 11px;
		color: #888;
		margin-bottom: 10px;
	}
	.product-links {
		display: flex;
		gap: 6px;
	}
	.btn-rakuten {
		font-size: 11px;
		padding: 4px 10px;
		background: #bf0000;
		color: white;
		border-radius: 20px;
		text-decoration: none;
	}
	.shop-footer-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 1.5rem;
		padding-top: 1.5rem;
		border-top: 0.5px solid #e8e4da;
		font-size: 0.875rem;
	}
	.shop-footer-nav a {
		color: #2d6a4f;
		text-decoration: underline;
	}
</style>
