---
interface Props {
	title: string;
	brand?: string;
	volume?: string;
	priceNote?: string;
	description: string;
	amazonUrl: string;
	imageUrl: string;
	imageAlt: string;
	label?: string;
}

const {
	title,
	brand,
	volume,
	priceNote,
	description,
	amazonUrl,
	imageUrl,
	imageAlt,
	label = 'おすすめアイテム',
} = Astro.props;
---

<aside class="sidebar-amazon-card" aria-label={title}>
	<p class="sidebar-amazon-card__label">{label}</p>
	<a
		class="sidebar-amazon-card__link"
		href={amazonUrl}
		rel="nofollow sponsored noopener"
		target="_blank"
	>
		<div class="sidebar-amazon-card__media">
			<img src={imageUrl} alt={imageAlt} width="160" height="160" loading="lazy" />
		</div>
		<div class="sidebar-amazon-card__body">
			{brand ? <p class="sidebar-amazon-card__brand">{brand}</p> : null}
			<p class="sidebar-amazon-card__title">{title}</p>
			{volume || priceNote ? (
				<p class="sidebar-amazon-card__meta">
					{volume}
					{volume && priceNote ? ' · ' : null}
					{priceNote}
				</p>
			) : null}
			<p class="sidebar-amazon-card__desc">{description}</p>
		</div>
	</a>
	<a
		class="btn-amazon btn-amazon--block sidebar-amazon-card__cta"
		href={amazonUrl}
		rel="nofollow sponsored noopener"
		target="_blank"
	>
		Amazonで見る →
	</a>
	<p class="sidebar-amazon-card__note">価格・在庫はAmazonでご確認ください</p>
</aside>

<style>
	.sidebar-amazon-card {
		margin-top: 14px;
		background: #fff;
		border: 0.5px solid #e8e4da;
		border-radius: 12px;
		padding: 14px;
		font-size: 0.8rem;
	}

	@media (min-width: 768px) {
		.sidebar-amazon-card {
			width: 200px;
		}
	}

	.sidebar-amazon-card__label {
		margin: 0 0 10px;
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.06em;
		color: #2d6a4f;
		text-transform: uppercase;
	}

	.sidebar-amazon-card__link {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.sidebar-amazon-card__link:hover .sidebar-amazon-card__title {
		color: #2d6a4f;
	}

	.sidebar-amazon-card__media {
		display: flex;
		justify-content: center;
		align-items: center;
		aspect-ratio: 1;
		margin-bottom: 10px;
		padding: 8px;
		background: linear-gradient(180deg, #faf8f3 0%, #f3efe6 100%);
		border: 0.5px solid #ece6da;
		border-radius: 8px;
	}

	.sidebar-amazon-card__media img {
		width: 100%;
		max-width: 120px;
		height: auto;
		object-fit: contain;
	}

	.sidebar-amazon-card__brand {
		margin: 0 0 4px;
		font-size: 10px;
		color: #8a8275;
	}

	.sidebar-amazon-card__title {
		margin: 0 0 6px;
		font-size: 12px;
		font-weight: 600;
		line-height: 1.45;
		color: #1f2937;
		transition: color 0.15s ease;
	}

	.sidebar-amazon-card__meta {
		margin: 0 0 8px;
		font-size: 10px;
		color: #6b7280;
	}

	.sidebar-amazon-card__desc {
		margin: 0;
		font-size: 11px;
		line-height: 1.6;
		color: #5a5040;
	}

	.sidebar-amazon-card__cta {
		margin-top: 12px;
	}

	.sidebar-amazon-card__note {
		margin: 8px 0 0;
		font-size: 9px;
		line-height: 1.5;
		color: #9ca3af;
		text-align: center;
	}
</style>
